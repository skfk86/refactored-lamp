{
  "appId": "sd.sira.app",
  "appName": "سيرة",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": false
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "loggingBehavior": "none",
    "backgroundColor": "#f7f9fb",
    "initialFocus": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#002045",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  }
}
